    {
      "id": "review-follow-up-guard",
      "name": "Review Follow-up Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const row = $('Parse Sentiment').first().json;\n  const reviews = $input.all().map(i => i.json);\n  const name = String(row.customer_name).trim().toLowerCase();\n  const sent = Date.parse(row.created_at ?? row.received_at);\n  const found = reviews.some(r => String(r.reviewer?.displayName ?? r.reviewerDisplayName ?? '').trim().toLowerCase() === name && Date.parse(r.createTime ?? r.updateTime ?? 0) >= sent - 14 * 86400000);\n  return [{ json: { ...row, review_detected: found } }];"
      },
      "position": [
        2920,
        60
      ]
    },
