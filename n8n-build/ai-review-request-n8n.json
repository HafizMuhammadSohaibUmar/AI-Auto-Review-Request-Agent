    {
      "id": "credentials-and-safety-notes",
      "name": "Credentials and Safety Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "parameters": {
        "width": 700,
        "height": 460,
        "content": "## Credentials required before activation\nJobber webhook secret and/or Housecall Pro webhook secret; Supabase service-role credential; Mistral API credential for https://api.mistral.ai/v1/chat/completions; Twilio Account SID/Auth Token and approved SMS sender; Google Business Profile OAuth credential for review detection; owner E.164 number.\n\nValid JSON cannot contain comments, so this sticky note is the requested top-of-file credential block. Replace every REPLACE_WITH_* value. Verify Jobber/HCP HMAC signatures at ingress before production. Keep inactive until consent, STOP handling, SMS sender compliance, CRM webhook tests, and internal-number tests pass."
      },
      "position": [
        -520,
        -620
      ]
    },
    {
      "id": "job-completed-webhook",
      "name": "Job Completed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "parameters": {
        "httpMethod": "POST",
        "path": "review-request-job-completed-n8n",
        "responseMode": "onReceived",
        "options": {}
      },
      "position": [
        -380,
        -180
      ]
    },
    {
      "id": "normalize-completed-job",
      "name": "Normalize Completed Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const p = $input.first().json.body ?? $input.first().json;\n  const e = p.event ?? p.data ?? p;\n  const phone = e.customer_phone ?? e.customer?.phone ?? e.client?.phones?.[0]?.number ?? e.phone;\n  const name = e.customer_name ?? e.customer?.name ?? e.client?.name ?? e.name ?? 'Customer';\n  const jobId = e.job_id ?? e.job?.id ?? e.id;\n  if (!phone || !jobId) throw new Error('Completed-job webhook requires customer phone and job id');\n  return [{ json: { business_id: 'REPLACE_WITH_BUSINESS_ID', job_id: String(jobId), customer_phone: phone, customer_name: name, job_type: e.job_type ?? e.service_type ?? e.title ?? 'home service', technician_name: e.technician_name ?? e.technician?.name ?? 'our technician', job_notes: e.job_notes ?? e.notes ?? e.summary ?? '', completed_at: e.completed_at ?? e.completedAt ?? new Date().toISOString(), received_at: new Date().toISOString() } }];"
      },
      "position": [
        -140,
        -180
      ]
    },
    {
      "id": "90-day-dedup-supabase-",
      "name": "90-Day Dedup (Supabase)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "n8n_review_requests",
        "returnAll": true,
        "filters": {
          "conditions": [
            {
              "keyName": "customer_phone",
              "condition": "eq",
              "keyValue": "={{ $('Normalize Completed Job').first().json.customer_phone }}"
            },
            {
              "keyName": "created_at",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ days: 90 }).toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "position": [
        100,
        -180
      ],
      "alwaysOutputData": true
    },
    {
      "id": "four-hour-placeholder-guard",
      "name": "Four-Hour Placeholder Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const event = $('Normalize Completed Job').first().json;\n  const rows = $input.all().map(i => i.json);\n  const cutoff = Date.now() - 90 * 24 * 60 * 60 * 1000;\n  const duplicate = rows.some(r => r.job_id === event.job_id || (r.customer_phone === event.customer_phone && Date.parse(r.created_at) >= cutoff));\n  return [{ json: { ...event, duplicate } }];"
      },
      "position": [
        340,
        -180
      ]
    },
    {
      "id": "not-deduplicated-",
      "name": "Not Deduplicated?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ]
        },
        "options": {}
      },
      "position": [
        560,
        -180
      ]
    },
    {
      "id": "classify-job-notes-ministral-3b",
      "name": "Classify Job Notes - Ministral 3B",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.mistral.ai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'ministral-3b-latest',temperature:0,response_format:{type:'json_object'},messages:[{role:'system',content:'Classify home-service customer/job notes. Return JSON only: {sentiment: POSITIVE|NEUTRAL|NEGATIVE, rationale: short string}. NEGATIVE means complaint, unresolved issue, frustration, or explicit dissatisfaction. POSITIVE means clear satisfaction. Use NEUTRAL when unclear or uncertain.'},{role:'user',content:$json.job_notes}]}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "position": [
        800,
        -180
      ]
    },
    {
      "id": "parse-sentiment",
      "name": "Parse Sentiment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const event = $('Four-Hour Placeholder Guard').first().json;\n  const raw = String($input.first().json.choices?.[0]?.message?.content ?? $input.first().json.output ?? '');\n  const cleaned = raw.replace(/^```(?:json)?/i, '').replace(/```$/i, '').trim();\n  let parsed;\n  try { parsed = JSON.parse(cleaned); } catch { parsed = { sentiment: 'NEUTRAL', rationale: 'Mistral response was not valid JSON; safe neutral fallback used.' }; }\n  const sentiment = ['POSITIVE', 'NEUTRAL', 'NEGATIVE'].includes(String(parsed.sentiment).toUpperCase()) ? String(parsed.sentiment).toUpperCase() : 'NEUTRAL';\n  return [{ json: { ...event, sentiment, rationale: parsed.rationale ?? '' } }];"
      },
      "position": [
        1040,
        -180
      ]
    },
    {
      "id": "negative-sentiment-",
      "name": "Negative Sentiment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.sentiment }}",
              "rightValue": "NEGATIVE",
              "operator": {
                "type": "string",
                "operation": "equal"
              }
            }
          ]
        },
        "options": {}
      },
      "position": [
        1260,
